{
  "env": {
    "browser": true,
    "node": true,
    "es2021": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "script"
  },
  "rules": {
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "no-unused-vars": ["warn"]
  },
  "overrides": [
    {
      "files": ["test-runner.js"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
